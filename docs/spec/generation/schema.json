          },
          "maxItems": 2000,
          "title": "Source Refs",
          "type": "array"
        },
        "title": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "section_id",
        "title"
      ],
      "title": "OutlineSection",
      "type": "object"
    },
    "RunEvent": {
      "additionalProperties": false,
      "description": "按运行单调递增、持久化后才发布的回放事件。",
      "properties": {
        "created_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Created At"
        },
        "event_id": {
          "minimum": 1,
          "title": "Event Id",
          "type": "integer"
        },
        "format_version": {
          "default": "1.0.0",
          "title": "Format Version",
          "type": "string"
        },
        "payload": {
          "additionalProperties": true,
          "maxProperties": 100,
          "title": "Payload",
          "type": "object"
        },
        "run_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
          "title": "Run Id",
          "type": "string"
        },
        "type": {
