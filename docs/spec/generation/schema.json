        "run_id",
        "type"
      ],
      "title": "RunEvent",
      "type": "object"
    },
    "SectionDraft": {
      "additionalProperties": false,
      "description": "无来源的人工作品必须显式声明 edited。",
      "properties": {
        "blocks": {
          "items": {
            "$ref": "#/$defs/DraftBlock"
