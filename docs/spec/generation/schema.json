    "WritingResult": {
      "additionalProperties": false,
      "description": "生成候选；消费者必须检查来源与数字支持后才能采用。",
      "properties": {
        "error": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
