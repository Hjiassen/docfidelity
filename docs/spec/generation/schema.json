            "bullets",
            "numbered",
            "table",
            "figure"
          ],
          "title": "Kind",
          "type": "string"
        },
        "level": {
          "anyOf": [
            {
              "maximum": 9,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Level"
        },
        "locator": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Locator",
          "type": "string"
        },
        "rows": {
          "items": {
            "items": {
              "maxLength": 100000,
              "type": "string"
            },
            "type": "array"
          },
          "maxItems": 2000,
          "title": "Rows",
          "type": "array"
        },
        "text": {
          "default": "",
          "maxLength": 100000,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "block_id",
        "kind",
