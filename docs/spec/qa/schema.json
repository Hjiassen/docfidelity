{
  "$defs": {
    "Adjudication": {
      "additionalProperties": false,
      "description": "一次人工裁决的留痕（FR-M7-06 / NFR-15 / 需求 4.6.7）。\n\n为什么与 :class:`Waiver` 分开\n-----------------------------\n豁免只是三种规范动作之一，而且它与``接受``在**数据上**完全不同：豁免有有效期、\n有作用域、会改变 ``verdict``；接受与改配置只是留痕。把接受也塞进 ``waivers``，\n会让\"这份报告被豁免了几条\"这个数字变成\"这份报告被人看过几条\"，而报告汇总卡\n上那个数字正是定稿判据。\n\n``subject_id`` 而不是 ``finding_id``\n-----------------------------------\n待裁决项有两类：门禁判定（:attr:`Finding.finding_id`）与**待确认的决策项**\n（``Decision.decision_id``，模型低置信走了规则默认值的那条）。DD-13.2 只给了\n一条裁决提交路径，两类待办共用同一套规范动作——为决策项另开一条路径，\n等于让\"裁决\"的语义在两处各定义一次。故这里按\"**待裁决项**\"命名。",
      "properties": {
        "action": {
          "enum": [
            "accept",
            "configure",
            "waive"
          ],
          "title": "Action",
          "type": "string"
        },
        "adjudication_id": {
          "title": "Adjudication Id",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "format_version": {
          "default": "1.0.0",
          "title": "Format Version",
          "type": "string"
        },
        "operator": {
          "description": "责任人；必填，可追溯性的一半（NFR-15）",
          "title": "Operator",
          "type": "string"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "理由；``action=waive`` 时必填",
          "title": "Reason"
        },
        "subject_id": {
          "description": "待裁决项标识：门禁判定 id 或决策项 id",
          "title": "Subject Id",
          "type": "string"
        },
        "waiver_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "仅 ``action=waive``",
          "title": "Waiver Id"
        }
      },
      "required": [
        "adjudication_id",
        "subject_id",
        "action",
        "operator",
        "created_at"
      ],
      "title": "Adjudication",
      "type": "object"
    },
    "Decision": {
      "additionalProperties": false,
      "description": "一次决策留痕。\n\n低置信（``confidence`` 低于档案 / 规则集阈值）或 ``status=\"pending\"`` 的决策，\n必须在界面上进入裁决队列；**不得静默采用**（验收 39）。",
      "properties": {
        "admission_evidence": {
          "additionalProperties": true,
          "description": "模型准入校验的依据与结果；不代表语义正确性或虚构的置信度",
          "title": "Admission Evidence",
          "type": "object"
        },
        "chosen": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Chosen"
        },
        "confidence": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "decision_id": {
          "title": "Decision Id",
          "type": "string"
        },
        "format_version": {
          "default": "1.0.0",
          "title": "Format Version",
          "type": "string"
        },
        "job_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Job Id"
        },
        "kind": {
          "description": "决策点标识",
          "title": "Kind",
          "type": "string"
        },
        "options": {
          "items": {
            "$ref": "#/$defs/DecisionOption"
          },
          "title": "Options",
          "type": "array"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "source": {
          "default": "rule_default",
          "enum": [
            "rule_default",
            "model",
            "manual",
            "fallback"
          ],
          "title": "Source",
          "type": "string"
        },
        "status": {
          "default": "auto",
          "enum": [
            "auto",
            "pending",
            "confirmed",
            "rejected"
          ],
          "title": "Status",
          "type": "string"
        },
        "target": {
          "description": "作用对象：单元 id / 槽位 id / 模板引用等",
          "title": "Target",
          "type": "string"
        }
      },
      "required": [
        "decision_id",
        "kind",
        "target",
        "created_at"
      ],
      "title": "Decision",
      "type": "object"
    },
    "DecisionOption": {
      "additionalProperties": false,
      "description": "一个候选选项。低置信选项必须给出 ``reason``，供人在裁决队列中判断。",
      "properties": {
        "confidence": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        },
        "format_version": {
          "default": "1.0.0",
          "title": "Format Version",
          "type": "string"
        },
        "label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "value": {
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "value"
      ],
      "title": "DecisionOption",
      "type": "object"
    },
    "EngineErrorInfo": {
      "additionalProperties": false,
      "description": "可持久化的错误快照。\n\n落库位置：``stages.error``。与 :class:`EngineError` 分离的原因是把**异常**\n（控制流）与**快照**（数据）分开——快照可以直接进 JSON 响应与数据库，\n异常对象不行。",
      "properties": {
        "code": {
          "description": "错误码，取值见 ErrorCode",
          "title": "Code",
          "type": "string"
        },
        "fatal": {
          "default": true,
          "description": "False 表示可降级继续，不作为失败终态",
          "title": "Fatal",
          "type": "boolean"
        },
        "message": {
          "description": "面向使用者的中文说明",
          "title": "Message",
          "type": "string"
        },
        "remediation": {
          "description": "可执行动作清单",
          "items": {
            "type": "string"
          },
          "title": "Remediation",
          "type": "array"
        },
        "where": {
          "additionalProperties": true,
          "description": "结构化定位信息",
          "title": "Where",
          "type": "object"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "EngineErrorInfo",
      "type": "object"
    },
    "Finding": {
      "additionalProperties": false,
      "description": "一条判定结果。\n\n``finding_id`` 为什么是一个字段\n------------------------------\n界面要能**指认**一条判定才能对它提交裁决（``POST /findings/{fid}/decisions``），\n而在那之前 ``Finding`` 只有内容、没有身份——调用方唯一能用的坐标是\"报告里第几条\"，\n那等于让前端自己算一个标识（DD-14.3 禁止的\"前端推断\"），而且一旦有人重排\n``findings``，\"第 3 条\"就悄悄指向了另一条规则。\n\n标识由 ``qa`` 在产出报告时赋值（``<报告标识>@<序号>``），故它**不参与**任何判定：\n是用户级可选项，缺失时接口层按\"这条判定不可寻址\"处理，而不是回退到下标。",
      "properties": {
        "evidence": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "命中的具体内容片段，供人工复核",
          "title": "Evidence"
        },
        "finding_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "可寻址标识（``<报告标识>@<序号>``）；由 qa 产出报告时赋值",
          "title": "Finding Id"
        },
        "format_version": {
          "default": "1.0.0",
          "title": "Format Version",
          "type": "string"
        },
        "location": {
          "$ref": "#/$defs/Location"
        },
        "message": {
          "description": "面向使用者的中文说明",
          "title": "Message",
          "type": "string"
        },
        "rule_id": {
          "title": "Rule Id",
          "type": "string"
        },
        "severity": {
          "enum": [
            "blocker",
            "major",
            "minor"
          ],
          "title": "Severity",
          "type": "string"
        },
        "status": {
          "default": "open",
          "enum": [
            "open",
            "waived",
            "fixed"
          ],
          "title": "Status",
          "type": "string"
        },
        "suggestion": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "可执行建议",
          "title": "Suggestion"
        },
        "waiver_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Waiver Id"
        }
      },
      "required": [
        "rule_id",
        "severity",
        "message"
      ],
      "title": "Finding",
      "type": "object"
    },
    "Location": {
      "additionalProperties": false,
      "description": "问题的定位。定位必须**足够具体**，以便界面直接跳到对应位置。\n\n内容类问题给 ``unit_id`` + ``chapter_path``；样式类问题给 ``part`` + ``xpath``；\n目检类问题补 ``page_hint``。",
      "properties": {
        "chapter_path": {
          "description": "章节路径，如 ['概述','范围']",
          "items": {
            "type": "string"
          },
          "title": "Chapter Path",
          "type": "array"
        },
        "format_version": {
          "default": "1.0.0",
          "title": "Format Version",
          "type": "string"
        },
        "page_hint": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "目检图页码（若可用）",
          "title": "Page Hint"
        },
        "part": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "OOXML 部件名（样式 / 版式类命中才有）",
          "title": "Part"
        },
        "unit_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "定位到内容单元",
          "title": "Unit Id"
        },
        "xpath": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "精确到节点",
          "title": "Xpath"
        }
      },
      "title": "Location",
      "type": "object"
    },
    "ModelCall": {
      "additionalProperties": false,
      "description": "一次决策的模型调用汇总（Tracing，含全部重试）。\n\n失败时 ``ok=False`` 且 ``fallback_used=True``——这**不是**构建失败，\n只是决策降级（NFR-26 / 验收 39）。",
      "properties": {
        "attempts": {
          "default": 1,
          "description": "实际调用次数；token 为全部尝试累计值",
          "minimum": 1,
          "title": "Attempts",
          "type": "integer"
        },
        "call_id": {
          "title": "Call Id",
          "type": "string"
        },
        "confidence": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "decision_point": {
          "title": "Decision Point",
          "type": "string"
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/EngineErrorInfo"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "fallback_used": {
          "default": false,
          "title": "Fallback Used",
          "type": "boolean"
        },
        "format_version": {
          "default": "1.0.0",
          "title": "Format Version",
          "type": "string"
        },
        "job_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Job Id"
        },
        "latency_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Latency Ms"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "ok": {
          "default": true,
          "title": "Ok",
          "type": "boolean"
        },
        "route": {
          "description": "路由目标：agent 名 / 规划器标识",
          "title": "Route",
          "type": "string"
        },
        "tokens_in": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tokens In"
        },
        "tokens_out": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tokens Out"
        }
      },
      "required": [
        "call_id",
        "decision_point",
        "route",
        "created_at"
      ],
      "title": "ModelCall",
      "type": "object"
    },
    "Report": {
      "additionalProperties": false,
      "description": "门禁报告。\n\n``verdict`` 的算法由服务端给出，前端**不得推断**（唯一实现 = :func:`verdict_of`）：\n\n* 存在未豁免的 ``blocker`` -> ``blocked``\n* 否则存在未豁免的 ``major`` / ``minor`` -> ``warning``\n* 否则 -> ``pass``\n\n``skipped`` 为什么是一个字段\n---------------------------\n\"跳过了哪几条规则、因为缺哪项能力\"原本只写在 ``summary`` 那句散文里。\n一旦需要**重算**摘要（人工裁决之后必须重算，否则报告自相矛盾），散文里的话就\n提取不出来了——于是\"跳过\"这条信息会在第一次裁决后静默消失。做成字段之后，\n重算只需 :meth:`recompute`，而\"跳过\"作为数据可被查、可被断言。",
      "properties": {
        "adjudications": {
          "description": "人工裁决留痕（FR-M7-06）；与 waivers 并存：豁免只是三种动作之一",
          "items": {
            "$ref": "#/$defs/Adjudication"
          },
          "title": "Adjudications",
          "type": "array"
        },
        "decisions": {
          "description": "构建采用或降级的语义决策",
          "items": {
            "$ref": "#/$defs/Decision"
          },
          "title": "Decisions",
          "type": "array"
        },
        "findings": {
          "items": {
            "$ref": "#/$defs/Finding"
          },
          "title": "Findings",
          "type": "array"
        },
        "format_version": {
          "default": "1.0.0",
          "title": "Format Version",
          "type": "string"
        },
        "generated_at": {
          "format": "date-time",
          "title": "Generated At",
          "type": "string"
        },
        "job_id": {
          "title": "Job Id",
          "type": "string"
        },
        "model_calls": {
          "description": "支撑构建决策的调用证据",
          "items": {
            "$ref": "#/$defs/ModelCall"
          },
          "title": "Model Calls",
          "type": "array"
        },
        "report_id": {
          "title": "Report Id",
          "type": "string"
        },
        "skipped": {
          "description": "因缺依赖能力而跳过的规则（``rule_id(缺 能力)``）；**不是**「跑过且通过」",
          "items": {
            "type": "string"
          },
          "title": "Skipped",
          "type": "array"
        },
        "summary": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Summary"
        },
        "verdict": {
          "default": "pass",
          "enum": [
            "pass",
            "warning",
            "blocked"
          ],
          "title": "Verdict",
          "type": "string"
        },
        "waivers": {
          "items": {
            "$ref": "#/$defs/Waiver"
          },
          "title": "Waivers",
          "type": "array"
        }
      },
      "required": [
        "report_id",
        "job_id",
        "generated_at"
      ],
      "title": "Report",
      "type": "object"
    },
    "Rule": {
      "additionalProperties": false,
      "description": "一条门禁规则。\n\n规则以 YAML 声明、以 Python 断言函数实现（DD-10.1）。``params`` 承载阈值类参数，\n使同一实现可被多套规则集以不同阈值复用。",
      "properties": {
        "category": {
          "enum": [
            "style",
            "layout",
            "terminology",
            "integrity",
            "trace",
            "spotcheck",
            "meta"
          ],
          "title": "Category",
          "type": "string"
        },
        "convention_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "关联档案 conventions.id，用于说明规则来自哪条体例约定",
          "title": "Convention Ref"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "format_version": {
          "default": "1.0.0",
          "title": "Format Version",
          "type": "string"
        },
        "params": {
          "additionalProperties": true,
          "title": "Params",
          "type": "object"
        },
        "requires": {
          "description": "依赖的引擎能力标识；缺失时该规则应被跳过而非报错",
          "items": {
            "type": "string"
          },
          "title": "Requires",
          "type": "array"
        },
        "rule_id": {
          "description": "规则编号，如 FR-M5-07",
          "title": "Rule Id",
          "type": "string"
        },
        "severity": {
          "enum": [
            "blocker",
            "major",
            "minor"
          ],
          "title": "Severity",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "rule_id",
        "category",
        "severity",
        "title"
      ],
      "title": "Rule",
      "type": "object"
    },
    "RuleSet": {
      "additionalProperties": false,
      "description": "规则集：内置规则 + 项目覆盖。",
      "properties": {
        "excluded_rules": {
          "items": {
            "type": "string"
          },
          "title": "Excluded Rules",
          "type": "array"
        },
        "format_version": {
          "default": "1.0.0",
          "title": "Format Version",
          "type": "string"
        },
        "included_rules": {
          "items": {
            "type": "string"
          },
          "title": "Included Rules",
          "type": "array"
        },
        "param_overrides": {
          "additionalProperties": {
            "additionalProperties": true,
            "type": "object"
          },
