{
  "$defs": {
    "ImageExtent": {
      "additionalProperties": false,
      "description": "原件单次图片出现的可信显示尺寸，单位 EMU。",
      "properties": {
        "cx": {
          "exclusiveMinimum": 0,
          "title": "Cx",
          "type": "integer"
        },
        "cy": {
          "exclusiveMinimum": 0,
          "title": "Cy",
          "type": "integer"
        }
      },
      "required": [
        "cx",
        "cy"
      ],
      "title": "ImageExtent",
      "type": "object"
    },
    "MaterialBlock": {
      "additionalProperties": false,
      "description": "新材料语义与原件可信元数据；旧快照可省略图片尺寸。",
      "properties": {
        "block_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
          "title": "Block Id",
          "type": "string"
        },
        "columns": {
          "items": {
            "maxLength": 100000,
            "type": "string"
          },
          "maxItems": 100,
          "title": "Columns",
          "type": "array"
        },
        "format_version": {
          "default": "1.0.0",
          "title": "Format Version",
          "type": "string"
        },
        "image_extent": {
          "anyOf": [
            {
              "$ref": "#/$defs/ImageExtent"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "image_ref": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_./-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Image Ref"
        },
        "items": {
          "items": {
            "maxLength": 100000,
            "type": "string"
          },
          "maxItems": 2000,
          "title": "Items",
          "type": "array"
        },
        "kind": {
          "enum": [
            "heading",
            "para",
            "bullets",
            "numbered",
            "table",
            "figure"
          ],
          "title": "Kind",
          "type": "string"
        },
        "level": {
          "anyOf": [
            {
              "maximum": 9,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Level"
        },
        "locator": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Locator",
          "type": "string"
        },
        "rows": {
          "items": {
            "items": {
              "maxLength": 100000,
              "type": "string"
            },
            "type": "array"
          },
          "maxItems": 2000,
          "title": "Rows",
          "type": "array"
        },
        "text": {
          "default": "",
          "maxLength": 100000,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "block_id",
        "kind",
        "locator"
      ],
      "title": "MaterialBlock",
      "type": "object"
    },
    "SemanticMaterialBlock": {
      "additionalProperties": false,
      "description": "供正文模型读取的材料语义，不含原件几何。",
      "properties": {
        "block_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
          "title": "Block Id",
          "type": "string"
        },
        "columns": {
          "items": {
            "maxLength": 100000,
            "type": "string"
          },
          "maxItems": 100,
          "title": "Columns",
          "type": "array"
        },
        "format_version": {
          "default": "1.0.0",
          "title": "Format Version",
          "type": "string"
        },
        "image_ref": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_./-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Image Ref"
        },
        "items": {
          "items": {
            "maxLength": 100000,
            "type": "string"
          },
          "maxItems": 2000,
          "title": "Items",
          "type": "array"
        },
        "kind": {
          "enum": [
            "heading",
            "para",
            "bullets",
            "numbered",
            "table",
            "figure"
          ],
          "title": "Kind",
          "type": "string"
        },
        "level": {
          "anyOf": [
            {
              "maximum": 9,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Level"
        },
        "locator": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Locator",
          "type": "string"
        },
        "rows": {
          "items": {
            "items": {
              "maxLength": 100000,
              "type": "string"
            },
            "type": "array"
          },
          "maxItems": 2000,
          "title": "Rows",
          "type": "array"
        },
        "text": {
          "default": "",
          "maxLength": 100000,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "block_id",
        "kind",
        "locator"
      ],
      "title": "SemanticMaterialBlock",
      "type": "object"
    },
    "SourceMaterial": {
      "additionalProperties": false,
      "description": "原始输入摘要与完整的有序材料块；不支持对象进入待确认。",
      "properties": {
        "blocks": {
          "items": {
            "$ref": "#/$defs/MaterialBlock"
          },
          "maxItems": 2000,
          "minItems": 1,
          "title": "Blocks",
          "type": "array"
        },
        "digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "format_version": {
          "default": "1.0.0",
          "title": "Format Version",
          "type": "string"
        },
        "material_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
          "title": "Material Id",
          "type": "string"
        },
        "media_type": {
          "enum": [
            "text",
            "markdown",
            "docx"
          ],
          "title": "Media Type",
          "type": "string"
        },
        "name": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "pending": {
          "items": {
            "maxLength": 2000,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 2000,
          "title": "Pending",
          "type": "array"
        }
      },
      "required": [
        "material_id",
        "name",
        "media_type",
        "digest",
        "blocks"
      ],
      "title": "SourceMaterial",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "docfidelity contracts: materials",
  "x-contract-family": "materials",
  "x-contract-models": [
    "MaterialBlock",
    "SemanticMaterialBlock",
    "SourceMaterial"
  ]
}
