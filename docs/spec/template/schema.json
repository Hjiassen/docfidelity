          "items": {
            "type": "string"
          },
          "title": "Diff From Previous",
          "type": "array"
        },
        "footer_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "页脚部件关系 ID（归一化后）",
          "title": "Footer Ref"
        },
        "format_version": {
          "default": "1.0.0",
          "title": "Format Version",
          "type": "string"
        },
        "header_footer_roles": {
          "items": {
            "enum": [
              "default",
              "first",
              "even"
            ],
            "type": "string"
          },
          "title": "Header Footer Roles",
          "type": "array"
        },
        "header_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "页眉部件关系 ID（归一化后）",
          "title": "Header Ref"
        },
        "index": {
          "description": "节序号，0 起",
          "title": "Index",
          "type": "integer"
        },
        "margins": {
          "$ref": "#/$defs/Margins"
        },
        "page_size": {
          "$ref": "#/$defs/PageSize"
        },
        "start_type": {
          "anyOf": [
            {
              "enum": [
                "continuous",
                "nextPage",
                "evenPage",
                "oddPage"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start Type"
        }
      },
      "required": [
        "index",
        "page_size",
        "margins"
      ],
      "title": "SectionSpec",
      "type": "object"
    },
    "SlotSpec": {
