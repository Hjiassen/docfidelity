    "TableStylePr": {
      "additionalProperties": false,
      "description": "表格条件格式（``w:tblStylePr``）。\n\n**不得省略**：``firstRow`` / ``lastRow`` / ``band1Horz`` 等条件格式直接决定\n表头与隔行底纹是否保真。跨文档克隆表格样式时若丢掉本字段，产物会在\nWord 中\"看起来样式没变、实际表头掉色\"（1.2 第 8 条教训）。",
      "properties": {
        "bold": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bold"
        },
        "font_color": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "字体颜色 RGB，如 '1F3864'",
          "title": "Font Color"
        },
        "format_version": {
          "default": "1.0.0",
          "title": "Format Version",
          "type": "string"
        },
        "italic": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Italic"
        },
        "raw_xml": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "未建模属性的原始 XML 片段。**保留不丢**，回写时原样还原。",
          "title": "Raw Xml"
        },
        "shading_fill": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "底纹填充，如 'D9E2F3'",
          "title": "Shading Fill"
        },
        "type": {
          "enum": [
            "firstRow",
            "lastRow",
            "firstCol",
            "lastCol",
            "band1Vert",
            "band1Horz",
            "band2Vert",
            "band2Horz",
            "neCell",
            "nwCell",
            "seCell",
            "swCell"
          ],
          "title": "Type",
          "type": "string"
        }
