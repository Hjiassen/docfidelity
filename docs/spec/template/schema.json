{
  "$defs": {
    "AbstractNum": {
      "additionalProperties": false,
      "description": "抽象编号定义，对应 ``w:abstractNum``。",
      "properties": {
        "abstract_num_id": {
          "title": "Abstract Num Id",
          "type": "integer"
        },
        "format_version": {
          "default": "1.0.0",
          "title": "Format Version",
          "type": "string"
        },
        "levels": {
          "items": {
            "$ref": "#/$defs/NumberLevel"
          },
          "title": "Levels",
          "type": "array"
        }
      },
      "required": [
        "abstract_num_id"
      ],
      "title": "AbstractNum",
      "type": "object"
    },
    "BlockEntry": {
      "additionalProperties": false,
      "description": "模板中一个可复用块的索引条目。",
      "properties": {
        "block_id": {
          "title": "Block Id",
          "type": "string"
        },
        "cross_template_ref": {
          "default": false,
          "description": "该块是否引用了跨模板资源（如外部图片、链接）",
          "title": "Cross Template Ref",
          "type": "boolean"
        },
        "format_version": {
          "default": "1.0.0",
          "title": "Format Version",
          "type": "string"
        },
        "kind": {
          "enum": [
            "cover",
            "revision",
            "toc",
            "header",
            "table"
          ],
          "title": "Kind",
          "type": "string"
        },
        "locator": {
          "$ref": "#/$defs/BlockLocator"
        },
        "structure": {
          "additionalProperties": true,
          "description": "块的结构摘要（行数 / 列数 / 占位符数量等）",
          "title": "Structure",
          "type": "object"
        }
      },
      "required": [
        "block_id",
        "kind",
        "locator"
      ],
      "title": "BlockEntry",
      "type": "object"
    },
    "BlockIndex": {
      "additionalProperties": false,
      "description": "块索引。修订记录表、目录、固定表单等按原样复用，不重新构造。",
      "properties": {
        "blocks": {
          "items": {
            "$ref": "#/$defs/BlockEntry"
          },
          "title": "Blocks",
          "type": "array"
        },
        "format_version": {
          "default": "1.0.0",
          "title": "Format Version",
          "type": "string"
        }
      },
      "title": "BlockIndex",
      "type": "object"
    },
    "BlockLocator": {
      "additionalProperties": false,
      "description": "块 / 占位符在 OOXML 包内的定位。\n\n``xpath`` 必须在同一部件的同一快照下稳定；涉及易变标识（``_Toc`` 书签 ID、\n部件关系 ID）时，定位必须落在归一化之后的形式上（DD-4.7）。",
      "properties": {
        "format_version": {
          "default": "1.0.0",
          "title": "Format Version",
          "type": "string"
        },
        "index": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "同 XPath 命中多项时的序号（0 起）",
          "title": "Index"
        },
        "part": {
          "description": "部件路径，如 word/document.xml",
          "title": "Part",
          "type": "string"
        },
        "xpath": {
          "description": "精确到节点的 XPath",
          "title": "Xpath",
          "type": "string"
        }
      },
      "required": [
        "part",
        "xpath"
      ],
      "title": "BlockLocator",
      "type": "object"
    },
    "ChapterNode": {
      "additionalProperties": false,
      "description": "章节骨架节点。层级由 ``level`` 表达，允许非连续层级的模板（如只有 1/3 级）。",
      "properties": {
        "children": {
          "items": {
            "$ref": "#/$defs/ChapterNode"
          },
          "title": "Children",
          "type": "array"
        },
        "format_version": {
          "default": "1.0.0",
          "title": "Format Version",
          "type": "string"
        },
        "level": {
          "minimum": 1,
          "title": "Level",
          "type": "integer"
        },
        "slots": {
          "items": {
            "$ref": "#/$defs/SlotSpec"
          },
          "title": "Slots",
          "type": "array"
        },
        "style_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "该级标题使用的段落样式 ID",
          "title": "Style Id"
        },
        "title": {
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "level",
        "title"
      ],
      "title": "ChapterNode",
      "type": "object"
    },
    "HeadingBinding": {
      "additionalProperties": false,
      "description": "标题样式到编号的绑定：``styleId`` -> ``numId`` + ``ilvl``。",
      "properties": {
        "format_version": {
          "default": "1.0.0",
          "title": "Format Version",
          "type": "string"
        },
        "ilvl": {
          "title": "Ilvl",
          "type": "integer"
        },
        "num_id": {
          "title": "Num Id",
          "type": "integer"
        },
        "style_id": {
          "title": "Style Id",
          "type": "string"
        }
      },
      "required": [
        "style_id",
        "num_id",
        "ilvl"
      ],
      "title": "HeadingBinding",
      "type": "object"
    },
    "Margins": {
      "additionalProperties": false,
      "description": "页边距（twips）。",
      "properties": {
        "bottom_twips": {
          "title": "Bottom Twips",
          "type": "integer"
        },
        "footer_twips": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Footer Twips"
        },
        "format_version": {
          "default": "1.0.0",
          "title": "Format Version",
          "type": "string"
        },
        "gutter_twips": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Gutter Twips"
        },
        "header_twips": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Header Twips"
        },
        "left_twips": {
          "title": "Left Twips",
          "type": "integer"
        },
        "right_twips": {
          "title": "Right Twips",
          "type": "integer"
        },
        "top_twips": {
          "title": "Top Twips",
          "type": "integer"
        }
      },
      "required": [
        "top_twips",
        "bottom_twips",
        "left_twips",
        "right_twips"
      ],
      "title": "Margins",
      "type": "object"
    },
    "NumInstance": {
      "additionalProperties": false,
      "description": "编号实例，对应 ``w:num``；把 ``numId`` 映射到 ``abstractNumId``。",
      "properties": {
        "abstract_num_id": {
          "title": "Abstract Num Id",
          "type": "integer"
        },
        "format_version": {
          "default": "1.0.0",
          "title": "Format Version",
          "type": "string"
        },
        "num_id": {
          "title": "Num Id",
          "type": "integer"
        }
      },
      "required": [
        "num_id",
        "abstract_num_id"
      ],
      "title": "NumInstance",
      "type": "object"
    },
    "NumberLevel": {
      "additionalProperties": false,
      "description": "编号层级，对应 ``w:lvl``。",
      "properties": {
        "font_east_asian": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Font East Asian"
        },
        "format_version": {
          "default": "1.0.0",
          "title": "Format Version",
          "type": "string"
        },
        "ilvl": {
          "title": "Ilvl",
          "type": "integer"
        },
        "indent_hanging_twips": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Indent Hanging Twips"
        },
        "indent_left_twips": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Indent Left Twips"
        },
        "lvl_text": {
          "description": "编号模板文本，如 '%1.%2'",
          "title": "Lvl Text",
          "type": "string"
        },
        "num_fmt": {
          "description": "编号格式，如 decimal / chineseCounting / lowerLetter",
          "title": "Num Fmt",
          "type": "string"
        },
        "start": {
          "default": 1,
          "title": "Start",
          "type": "integer"
        }
      },
      "required": [
        "ilvl",
        "num_fmt",
        "lvl_text"
      ],
      "title": "NumberLevel",
      "type": "object"
    },
    "NumberingContract": {
      "additionalProperties": false,
      "description": "编号体系契约。章节注入后必须按本契约重算编号（DD-9.1 步骤顺序）。",
      "properties": {
        "abstract_num": {
          "items": {
            "$ref": "#/$defs/AbstractNum"
          },
          "title": "Abstract Num",
          "type": "array"
        },
        "format_version": {
          "default": "1.0.0",
          "title": "Format Version",
          "type": "string"
        },
        "heading_bindings": {
          "items": {
            "$ref": "#/$defs/HeadingBinding"
          },
          "title": "Heading Bindings",
          "type": "array"
        },
        "num": {
          "items": {
            "$ref": "#/$defs/NumInstance"
          },
          "title": "Num",
          "type": "array"
        }
      },
      "title": "NumberingContract",
      "type": "object"
    },
    "OutlineSkeleton": {
      "additionalProperties": false,
      "description": "章节骨架契约。装配层据此决定\"哪些章节必须有、可以挂什么内容\"。",
      "properties": {
        "allowed_block_types": {
          "items": {
            "enum": [
              "cover",
              "revision",
              "toc",
              "header",
              "table"
            ],
            "type": "string"
          },
          "title": "Allowed Block Types",
          "type": "array"
        },
        "chapter_tree": {
          "items": {
            "$ref": "#/$defs/ChapterNode"
          },
          "title": "Chapter Tree",
          "type": "array"
        },
        "format_version": {
          "default": "1.0.0",
          "title": "Format Version",
          "type": "string"
        },
        "slots": {
          "description": "扁平索引，便于按 slot_id 直查",
          "items": {
            "$ref": "#/$defs/SlotSpec"
          },
          "title": "Slots",
          "type": "array"
        }
      },
      "title": "OutlineSkeleton",
      "type": "object"
    },
    "PageSetupContract": {
      "additionalProperties": false,
      "description": "版心契约。渲染期推导可用宽高只需要本模型 + 图片 ``wp:extent``。",
      "properties": {
        "format_version": {
          "default": "1.0.0",
          "title": "Format Version",
          "type": "string"
        },
        "margins": {
          "$ref": "#/$defs/Margins"
        },
        "page_size": {
          "$ref": "#/$defs/PageSize"
        },
        "sections": {
          "items": {
            "$ref": "#/$defs/SectionSpec"
          },
          "title": "Sections",
          "type": "array"
        }
      },
      "required": [
        "page_size",
        "margins"
      ],
      "title": "PageSetupContract",
      "type": "object"
    },
    "PageSize": {
      "additionalProperties": false,
      "description": "纸张尺寸（twips）。",
      "properties": {
        "format_version": {
          "default": "1.0.0",
          "title": "Format Version",
          "type": "string"
        },
        "height_twips": {
          "title": "Height Twips",
          "type": "integer"
        },
        "orientation": {
          "default": "portrait",
          "enum": [
            "portrait",
            "landscape"
          ],
          "title": "Orientation",
          "type": "string"
        },
        "width_twips": {
          "title": "Width Twips",
          "type": "integer"
        }
      },
      "required": [
        "width_twips",
        "height_twips"
      ],
      "title": "PageSize",
      "type": "object"
    },
    "PlaceholderEntry": {
      "additionalProperties": false,
      "description": "模板中的占位符 / 示例值。入库时识别，生成期必须被替换或显式清除。",
      "properties": {
        "format_version": {
          "default": "1.0.0",
          "title": "Format Version",
          "type": "string"
        },
        "locator": {
          "$ref": "#/$defs/BlockLocator"
        },
        "proposed_rule_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "建议由哪条门禁规则校验其是否被残留",
          "title": "Proposed Rule Id"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text",
        "locator"
      ],
      "title": "PlaceholderEntry",
      "type": "object"
    },
    "PlaceholderList": {
      "additionalProperties": false,
      "description": "占位符清单。",
      "properties": {
        "entries": {
          "items": {
            "$ref": "#/$defs/PlaceholderEntry"
          },
          "title": "Entries",
          "type": "array"
        },
        "format_version": {
          "default": "1.0.0",
          "title": "Format Version",
          "type": "string"
        }
      },
      "title": "PlaceholderList",
      "type": "object"
    },
    "ReviewOverride": {
      "additionalProperties": false,
      "description": "一条待确认项的处理留痕（P05 第 4 步）。\n\n与 :class:`~docfidelity.contracts.qa.Adjudication` 是**两个概念**，刻意不复用：\n那个是**门禁判定**的人工放行（``accept`` / ``configure`` / ``waive``，其中 ``waive``\n会改变交付结论）；本条是**入库解析**的低置信项确认，它不改变任何交付结论——\n入库报告没有\"结论\"可言，只有\"这件模板能不能登记\"。\n\n两者混成一种的代价很具体：模板解析的一个低置信项会出现在 ``/inbox`` 的待裁决\n列表里，而那个列表的语义是\"这些文档**还不能交付**\"。",
      "properties": {
        "action": {
          "enum": [
            "accept",
            "specify"
          ],
          "title": "Action",
          "type": "string"
        },
        "decided_at": {
          "format": "date-time",
          "title": "Decided At",
          "type": "string"
        },
        "evidence": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "判定依据快照，随件留存",
          "title": "Evidence"
        },
        "format_version": {
          "default": "1.0.0",
          "title": "Format Version",
          "type": "string"
        },
        "item_id": {
          "description": "待确认项标识，形如 <import_id>@<序号>",
          "title": "Item Id",
          "type": "string"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "处理意见",
          "title": "Note"
        },
        "operator": {
          "description": "责任人；必填（NFR-15）",
          "title": "Operator",
          "type": "string"
        },
        "rule_id": {
          "description": "产出该项的规则名（如 REG-OUTLINE）",
          "title": "Rule Id",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "``specify`` 时由人给出的取值",
          "title": "Value"
        }
      },
      "required": [
        "item_id",
        "rule_id",
        "action",
        "operator",
        "decided_at"
      ],
      "title": "ReviewOverride",
      "type": "object"
    },
    "SectionSpec": {
      "additionalProperties": false,
      "description": "分节差异。仅记录该节相对前一节**不同**的部分，未列出的项继承前一节。",
      "properties": {
        "diff_from_previous": {
