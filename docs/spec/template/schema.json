      ],
      "title": "TableStylePr",
      "type": "object"
    },
    "TemplateFingerprint": {
      "additionalProperties": false,
      "description": "模板指纹：各分区独立摘要，供分区级 diff（DD-7.4）。\n\n计算前必须归一化易变标识（``_Toc`` 书签 ID、部件关系 ID），\n否则同一模板每次解析都会得到不同指纹（DD-4.7）。",
      "properties": {
        "digest": {
          "description": "整体摘要：由其自身分区摘要合成，与分区顺序无关",
          "title": "Digest",
          "type": "string"
        },
        "format_version": {
          "default": "1.0.0",
          "title": "Format Version",
          "type": "string"
        },
        "sections": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "分区摘要：分区名 → 摘要，供分区级 diff；分区集合由 registry 定义",
          "title": "Sections",
          "type": "object"
        }
      },
      "required": [
        "digest"
      ],
      "title": "TemplateFingerprint",
      "type": "object"
    },
    "TemplateManifest": {
      "additionalProperties": false,
      "description": "模板包清单。模板包 ``contract/manifest.json`` 的内容。",
      "properties": {
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "doc_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "模板面向的文档类型（来自档案，可为空）",
          "title": "Doc Type"
        },
        "format_version": {
          "default": "1.0.0",
          "title": "Format Version",
          "type": "string"
        },
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        },
        "package_hash": {
          "description": "包内容摘要，覆盖 contract/ + blocks/ + placeholders.json，**不含** fingerprint.json（避免自指）",
          "title": "Package Hash",
          "type": "string"
        },
        "source_filename": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Filename"
        },
        "source_hash": {
          "description": "模板原件摘要",
          "title": "Source Hash",
          "type": "string"
        },
        "template_id": {
          "description": "模板编号，来自模板封面 / 页眉的文件编号",
          "title": "Template Id",
          "type": "string"
        },
        "version": {
          "description": "模板版本",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "template_id",
        "version",
        "source_hash",
        "package_hash",
        "created_at"
      ],
      "title": "TemplateManifest",
      "type": "object"
    },
    "TemplateOverrides": {
      "additionalProperties": false,
      "description": "模板包内的 ``overrides.json``（DD-3.2 / 需求 P05 第 4 步「结果写入 overrides 配置」）。\n\n放在包里而不是库里：生成期按 ``DocumentEntry.overrides_ref`` 取它，\n而那个引用指向的是**模板包内**的文件。库侧另存一份必然漂移。\n\n**不参与** ``package_hash``（与 ``manifest.json`` 同处理）：包哈希覆盖的是\n\"这份模板解析出了什么\"，而本文件记录的是\"人就解析结果做了哪些确认\"。\n把它算进摘要的话，\"同一份模板 + 同一个决定\"会因为确认时间不同而算出两个哈希，\n版本比对会把一次人工确认显示成一次模板变更。",
      "properties": {
        "entries": {
          "items": {
            "$ref": "#/$defs/ReviewOverride"
          },
          "title": "Entries",
          "type": "array"
        },
        "format_version": {
          "default": "1.0.0",
          "title": "Format Version",
          "type": "string"
        },
        "template_ref": {
          "description": "``template_id@version``",
          "title": "Template Ref",
          "type": "string"
        }
      },
      "required": [
        "template_ref"
      ],
      "title": "TemplateOverrides",
      "type": "object"
    },
    "TemplatePackage": {
      "additionalProperties": false,
      "description": "模板包聚合视图。\n\n与模板包目录的对应关系::\n\n    <package>/\n    ├── contract/manifest.json      -> manifest\n    ├── contract/styles.json        -> styles\n    ├── contract/page_setup.json    -> page_setup\n    ├── contract/numbering.json     -> numbering\n    ├── contract/used_styles.json   -> used_styles\n    ├── contract/outline.json       -> outline\n    ├── contract/blocks.json        -> blocks\n    ├── placeholders.json           -> placeholders\n    ├── fingerprint.json            -> fingerprint\n    ├── overrides.json              -> TemplateOverrides（人工确认留痕，不在本视图内）\n    └── blocks/                     -> 块原件（图片、嵌入对象等）",
      "properties": {
        "blocks": {
          "$ref": "#/$defs/BlockIndex"
        },
        "fingerprint": {
          "anyOf": [
            {
              "$ref": "#/$defs/TemplateFingerprint"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "format_version": {
          "default": "1.0.0",
          "title": "Format Version",
          "type": "string"
        },
        "manifest": {
          "$ref": "#/$defs/TemplateManifest"
        },
        "numbering": {
          "$ref": "#/$defs/NumberingContract"
        },
        "outline": {
          "$ref": "#/$defs/OutlineSkeleton"
        },
        "page_setup": {
          "$ref": "#/$defs/PageSetupContract"
        },
        "placeholders": {
          "$ref": "#/$defs/PlaceholderList"
        },
        "styles": {
          "items": {
            "$ref": "#/$defs/StyleContract"
          },
          "title": "Styles",
          "type": "array"
        },
        "used_styles": {
          "$ref": "#/$defs/UsedStylesContract"
        }
      },
      "required": [
        "manifest",
        "page_setup"
      ],
      "title": "TemplatePackage",
      "type": "object"
    },
    "UsedStyle": {
      "additionalProperties": false,
      "description": "被使用过的样式及其出现次数。",
      "properties": {
        "count": {
          "default": 0,
          "minimum": 0,
          "title": "Count",
          "type": "integer"
        },
        "format_version": {
          "default": "1.0.0",
          "title": "Format Version",
          "type": "string"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "style_id": {
          "title": "Style Id",
          "type": "string"
        }
      },
      "required": [
        "style_id"
      ],
      "title": "UsedStyle",
      "type": "object"
    },
    "UsedStylesContract": {
      "additionalProperties": false,
      "description": "活跃 / 死样式的区分依据（FR-M2-13）。\n\n用于回答两个问题：① 裁剪模板冗余时哪些样式**不能删**；\n② 生成期新注入内容可以安全引用哪些样式。",
      "properties": {
        "format_version": {
          "default": "1.0.0",
          "title": "Format Version",
          "type": "string"
        },
        "p_style": {
          "items": {
            "$ref": "#/$defs/UsedStyle"
          },
          "title": "P Style",
          "type": "array"
        },
        "tbl_style": {
          "items": {
            "$ref": "#/$defs/UsedStyle"
          },
          "title": "Tbl Style",
          "type": "array"
        }
      },
      "title": "UsedStylesContract",
      "type": "object"
    }
  },
