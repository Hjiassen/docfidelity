# 容器部署的环境变量样例（**入库**；真正的 `.env` 不入库）。
#
# 用法：
#     cd deploy
#     cp .env.example .env      # 按需改；不改也能 `docker compose up`
#
# `compose.yml` 会自动读取同目录下的 `.env`。键名由 `server.settings.ServerSettings`
# 定义（`env_prefix = "DOCFIDELITY_"`），完整清单见 `docs/设计/开发设计文档.md`
# 的运行配置表。
#
# ⚠️ 这里**只列与部署有关的键**，也不含任何模型配置——模型是可选能力（见文末）。

# ------------------------------------------------------------------ 存储与数据边界
# 工作区 / 产物 / 模板库的根。容器里固定挂在 /data 卷上（compose 把 ./data 映射进来），
# 改它只会把数据写到卷外，等于把"数据边界"这句话作废。
DOCFIDELITY_STORAGE_ROOT=/data

# 元数据库。**注释掉即用进程内仓储**（重启丢作业登记，适合纯演示）。
#
# `sqlite:////data/df.db` 里有**四个斜杠**：前三个是 scheme 分隔，第四个是绝对路径。
# 写成三个（`sqlite:///data/df.db`）会得到一个相对路径的库文件，落在当前工作目录，
# 而容器重启后工作目录里那份就没了——症状是"作业记录有时在有时不在"。
#
# 换 PostgreSQL 需要自己加驱动（`psycopg[binary]` 不在本项目的依赖里，DD-18.1 把
# postgres 列为可选件）；SQLite 在多进程并发写下会在 `database is locked` 上打转，
# 单机演示够用，压力稍大就该换库。
DOCFIDELITY_DATABASE_URL=sqlite:////data/df.db

# ------------------------------------------------------------------ 进程角色
# false = 由独立的 df-worker 服务消费作业（compose 的默认拓扑）。
# true  = 本进程内起 worker 线程（单容器部署用这个，并把 df-worker 停掉）。
DOCFIDELITY_START_WORKER=false

# 首启装载 `demo-templates/`（验收 31 一键体验）。**库非空时自动跳过**——
# 用户删掉示例之后重启，不该被硬塞回来。
DOCFIDELITY_SEED_DEMO_TEMPLATES=true

# ------------------------------------------------------------------ 确定性姿态
# true = 不让本机 Office 参与构建。容器里本来就没有 Word，显式钉住是为了让
# "产物字节取决于跑在哪台机器上"这件事不可能发生（NFR-02）。
DOCFIDELITY_DETERMINISTIC_MODE=true

# 数据边界面板显示什么。取值 local | intranet | public。
DOCFIDELITY_DEPLOYMENT=intranet

# ------------------------------------------------------------------ 保留策略（天）
# DOCFIDELITY_RETENTION_UPLOADS_DAYS=30
# DOCFIDELITY_RETENTION_WORKSPACE_DAYS=30
# DOCFIDELITY_RETENTION_ARTIFACTS_DAYS=180

# ------------------------------------------------------------------ 模型（可选）
# **默认关闭，且这是正常状态**：全链路走规则默认值，产出完整、token 为 0（NFR-13）。
# 三样齐备才挂适配层：MODEL_ENABLED + MODEL_BASE_URL + MODEL_NAME。
#
# DOCFIDELITY_MODEL_ENABLED=false
# DOCFIDELITY_MODEL_BASE_URL=
# DOCFIDELITY_MODEL_NAME=
# DOCFIDELITY_MODEL_API_KEY=
