# 本地环境变量的样例（**入库**；真正的 `.env` 不入库）。
#
# 用法：`cp .env.example .env` 后填上密钥。键名由 `server.settings.ServerSettings`
# 定义（env_prefix = "DOCFIDELITY_"），完整清单见 `docs/设计/开发设计文档.md` 的运行配置表。
#
# 留空的键用默认值：`MODEL_ENABLED=false` 即全链路纯确定性（NFR-13），
# 产出完整、token 为 0——这是"没配模型"该有的样子，而不是"功能缺一块"。

# 模型总开关。false 时连出口白名单都是空的（DataBoundary.external_calls）。
#
# ⚠️ **真正决定"会不会调模型"的是三样齐备**：本开关 + `MODEL_BASE_URL` + `MODEL_NAME`。
# 缺任何一样都退回确定性会话（全链路走规则默认值），而不是挂一个半好不坏的适配层——
# 缺 `MODEL_NAME` 时 SDK 会拿**它自己的**默认模型去配你给的端点，名字对不上、
# 多数网关直接 4xx，而界面上一切看起来"就绪"。
DOCFIDELITY_MODEL_ENABLED=false

# OpenAI 兼容端点。内核只把请求打到这个前缀上。
#
# ⚠️ **写上 `/v1`（除非服务方明确说不要）**：适配层用的是 openai 兼容 SDK，
# 它会在 base_url 后面自己拼 `/chat/completions`。少写 `/v1` 的效果是请求打到
# 站点根路径、拿回**前端 HTML 页面**——而且 `HTTP 200`，所以没有任何一层会报
# "地址错了"；症状会变成 SDK 内部一句
# `AttributeError: 'tuple' object has no attribute 'choices'`，
# 离真正的原因很远。**见过的表现形式：把域名直接当 base_url 用。**
#
# ⚠️ 端点需支持 **chat completions**（SDK 默认走 Responses API，多数第三方网关不支持）。
# 接上一个新端点后，建议先验它认不认 `response_format=json_schema`：不认的话每次决策
# 都会白花 `1 + 重试次数` 次调用后才退回规则默认值（产出仍完整）。
DOCFIDELITY_MODEL_BASE_URL=

# 默认模型标识。某决策点可以各自覆盖（RoutingConfig.decision_points[].model）。
DOCFIDELITY_MODEL_NAME=

# 密钥。**永不返回**（ServerSettings.data_boundary 只回 base_url 与 model），
# 也永不进日志（NFR-21）。
DOCFIDELITY_MODEL_API_KEY=
